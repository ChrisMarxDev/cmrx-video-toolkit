      "source": "components/lib/src/components.dart",
      "motion": false,
      "parameters": {
        "theme": {
          "label": "Theme",
          "type": "choice",
          "default": "light",
          "options": [
            "light",
            "dark"
          ]
        }
      },
      "variants": [
        {
          "id": "light",
          "props": {}
        },
        {
          "id": "dark",
          "props": {
            "theme": "dark"
          }
        }
      ]
    },
    {
      "id": "video.block",
