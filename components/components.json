      "widget": "VideoBlock",
      "category": "Content",
      "description": "A square block for one meaningful label or concept.",
      "source": "components/lib/src/components.dart",
      "motion": false,
      "parameters": {
        "active": {
          "label": "Active",
          "type": "bool",
          "default": false
        },
        "text": {
          "label": "Label",
          "type": "text",
          "default": "Context"
        },
        "padding": {
          "label": "Padding",
          "type": "number",
          "default": 20,
          "min": 8,
          "max": 40
        }
      },
      "variants": [
        {
          "id": "default",
          "props": {}
        },
        {
          "id": "active",
          "props": {
            "active": true
          }
        }
      ]
    },
    {
      "id": "video.caption",
