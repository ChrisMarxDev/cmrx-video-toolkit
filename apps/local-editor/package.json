{
  "name": "cmrx-local-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "start": "node dist/server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "agent": "node scripts/agent.mjs",
    "import": "node scripts/import.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"extensions/**/*.{mjs,json}\""
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
