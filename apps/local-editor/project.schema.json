{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local editor project v1",
  "description": "Portable authored project. See SCHEMA.md for relational invariants and comment lifecycle; model.ts validates service mutations.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "width": {
      "type": "number",
      "minimum": 64,
      "maximum": 3840,
      "multipleOf": 2
    },
    "height": {
      "type": "number",
      "minimum": 64,
      "maximum": 3840,
      "multipleOf": 2
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "clips": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/clip"
      }
    },
    "comments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/comment"
      }
    },
    "layers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-7]$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "muted": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "takeSections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "assetId",
          "takes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w-]{1,80}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "assetId": {
            "type": "string"
          },
          "preferredTakeId": {
            "type": "string"
          },
          "takes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "sourceStart",
                "sourceEnd"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\w-]{1,80}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "sourceStart": {
                  "type": "number",
                  "minimum": 0
                },
                "sourceEnd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "name",
    "width",
    "height",
    "fps",
    "assets",
    "clips"
  ],
  "additionalProperties": true,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^media/(?!.*\\.\\.)(?!.*\\\\).+"
        },
        "duration": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 7200
        },
        "audio": {
          "type": "boolean"
        },
        "transcript": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "text"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            },
            "additionalProperties": true
          }
        }
      },
      "required": [
        "id",
        "path",
        "duration",
        "audio"
      ],
      "additionalProperties": true
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "in": {
          "type": "number",
          "minimum": 0,
          "maximum": 7200
        },
        "duration": {
          "type": "number",
          "minimum": 0.016666666666666666,
          "maximum": 600
        },
        "track": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "x": {
          "type": "number",
          "minimum": -15360,
          "maximum": 3840
        },
        "y": {
          "type": "number",
          "minimum": -15360,
          "maximum": 3840
        },
        "width": {
          "type": "number",
          "minimum": 2,
          "maximum": 15360
        },
        "height": {
          "type": "number",
          "minimum": 2,
          "maximum": 15360
        },
        "muted": {
          "type": "boolean"
        },
        "props": {
          "type": "object"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 16,
          "default": 1
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "start",
        "in",
        "duration",
        "track",
        "x",
        "y",
        "width",
        "height",
        "muted"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "graphics"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "props"
            ],
            "properties": {
              "props": {
                "type": "object",
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^lib/[a-zA-Z0-9_/.-]+\\.dart$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "commentAnchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "timeline"
            },
            "time": {
              "type": "number",
              "minimum": 0,
              "maximum": 600
            }
          },
          "required": [
            "type",
            "time"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "clip"
            },
            "clipId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "sourceTime": {
              "type": "number",
              "minimum": 0,
              "maximum": 7800
            },
            "sourceAssetId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          },
          "required": [
            "type",
            "clipId",
            "sourceTime"
          ],
          "additionalProperties": true
        }
      ]
    },
    "comment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "createdRevision": {
          "type": "integer",
          "minimum": 0
        },
        "reopenedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "anchor": {
          "$ref": "#/$defs/commentAnchor"
        }
      },
      "required": [
        "id",
        "body",
        "status",
        "createdRevision",
        "anchor"
      ],
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "properties": {
        "width": {
          "maximum": 2160
        }
      }
    },
    {
      "properties": {
        "height": {
          "maximum": 2160
        }
      }
    }
  ]
}
