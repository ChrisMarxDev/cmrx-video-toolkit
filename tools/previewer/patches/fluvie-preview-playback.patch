@@ -0,0 +1,57 @@
+import 'dart:async';
+import 'package:flutter/material.dart' hide Animation, Clip, Image, Tween;
+import 'package:flutter_test/flutter_test.dart';
+import 'package:fluvie/fluvie.dart';
+
+class PendingAudio implements PreviewAudioController {
+  final ready = Completer<void>();
+  int activations = 0;
+  bool? playing;
+  Duration? position;
+  @override
+  Future<void> activate() { activations++; return ready.future; }
+  @override
+  Future<void> synchronize({required Duration position, required bool playing, required double rate}) async {
+    this.position = position; this.playing = playing;
+  }
+  @override
+  Future<void> dispose() async {}
+}
+void main() {
+  for (final fail in [false, true]) {
+    testWidgets('pending audio does not block play, seek or pause; failure=$fail', (tester) async {
+      final audio = PendingAudio();
+      final clock = LivePlaybackController(fps: 30, totalFrames: 300);
+      await tester.pumpWidget(MaterialApp(home: VideoPreview(
+        video: Video(width: 100, height: 100, fps: 30, scenes: [Scene(duration: 300.frames, children: [const Text('Preview')])]),
+        controller: clock, audio: audio, autoplay: false,
+      )));
+      await tester.pumpAndSettle();
+      await tester.tap(find.byTooltip('Play'));
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 200));
+      expect(clock.frame, greaterThan(0));
+      expect(find.byTooltip('Preparing audio'), findsOneWidget);
+      await tester.tap(find.byTooltip('Pause'));
+      await tester.pump();
+      clock.seek(60);
+      if (fail) { audio.ready.completeError(StateError('Audio unavailable')); }
+      else { audio.ready.complete(); }
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 200));
+      expect(clock.state, LivePlaybackState.paused);
+      expect(clock.frame, 60);
+      expect(audio.activations, 1);
+      if (!fail) {
+        expect(audio.playing, false);
+        expect(audio.position, const Duration(seconds: 2));
+      }
+      await tester.tap(find.byTooltip('Play'));
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 200));
+      expect(clock.frame, greaterThan(60));
+      await tester.pumpWidget(const SizedBox());
+      clock.dispose();
+    });
+  }
+}
