   @override
   final int? maxClipDecodeEdge;

+  final _captionCues = <CaptionSource, List<CaptionCue>>{};
+
+  @override
+  Future<void> preResolveCaptions(CaptionSource source) async {
+    if (_captionCues.containsKey(source)) return;
+    Future<String> text(String path) async =>
+        utf8.decode(await loader.load(MediaSource.asset(path)));
+    _captionCues[source] = switch (source) {
+      SrtCaptionSource(:final path) => parseSrt(await text(path)),
+      VttCaptionSource(:final path) => parseVtt(await text(path)),
+      InlineCaptionSource(:final words) => [
+        for (var i = 0; i < words.length; i++)
+          CaptionCue(
+            words[i].text,
+            start: words[i].at,
+            end: i + 1 < words.length ? words[i + 1].at : words[i].at + const Time.seconds(1),
+            words: [CaptionCueWord(words[i].text, at: words[i].at)],
+          ),
+      ],
+    };
+    markResolved();
+  }
+
+  @override
+  List<CaptionCue> cuesFor(CaptionSource source) =>
+      _captionCues[source] ??
+      (throw FluvieRenderException('Caption source was not prepared: $source'));
+
   @override
   void dispose() {
+    _captionCues.clear();
     disposeCachedImages();
     disposeClipFrames();
   }
